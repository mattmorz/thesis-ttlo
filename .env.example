# TTLO Portal - Production Environment Variables Template
# Copy this file to .env on your server and update all secrets before deploying

# Application Base Environment
NODE_ENV=production
PORT=3000
APP_NAME="TTLO Portal"
NEXTAUTH_URL=https://ttlo.yourdomain.com

# Authentication & JWT Security Secrets
# Generate a strong 32-byte secret (e.g. `openssl rand -hex 32`)
AUTH_SECRET=your_32_byte_secret_key_here
NEXTAUTH_SECRET=your_32_byte_secret_key_here

# Google OAuth Credentials (Google Cloud Console -> APIs & Services -> Credentials)
AUTH_GOOGLE_ID=your_google_oauth_client_id.apps.googleusercontent.com
AUTH_GOOGLE_SECRET=your_google_oauth_client_secret

# Allowed Email Domains & Role Grants
ALLOWED_DOMAINS=dlsu.edu.ph,carsu.edu.ph
ADMIN_EMAILS=admin@yourdomain.com,director@yourdomain.com
TTLO_STAFF_EMAILS=staff@yourdomain.com

# PostgreSQL Container & Connection Credentials
POSTGRES_DB=ttlo_db
POSTGRES_USER=ttlo_admin
POSTGRES_PASSWORD=your_strong_postgres_password_here
DATABASE_URL=postgres://ttlo_admin:your_strong_postgres_password_here@db:5432/ttlo_db

# Persistent Uploads Path
UPLOAD_PATH=/app/public/uploads

# Logging Configuration
LOG_LEVEL=info