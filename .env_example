# App auth
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_GOOGLE_REDIRECT_URI=

# Google Drive service account upload setup
# 1. Create a service account in Google Cloud Console.
# 2. Download the JSON key.
# 3. Share the target Drive folder with the service account email from the JSON.
# 4. Set GOOGLE_DRIVE_ROOT_FOLDER_ID to that folder's ID.
# 5. Point GOOGLE_APPLICATION_CREDENTIALS to the JSON file on the server.
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_DRIVE_ROOT_FOLDER_ID=

# Optional: provide the JSON contents directly instead of a file path.
GOOGLE_DRIVE_SERVICE_ACCOUNT_JSON=

# Optional if you upload into a shared drive instead of a personal folder.
GOOGLE_DRIVE_SHARED_DRIVE_ID=

# Database / app settings
DATABASE_URL=
MIDDLEWARE_RBAC=

