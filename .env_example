# Copy this file to `.env` for local development.

# Do not commit secrets here or in `.env`.

# App auth

AUTH_SECRET=
AUTH_URL="http://localhost:3000" # Required for production build. Change to your actual domain in production.
AUTH_TRUST_HOST=true # Optional alternative to AUTH_URL for local testing.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_GOOGLE_REDIRECT_URI=

# Google Drive upload setup

# Use a dedicated Google account as the central storage owner.

GOOGLE_DRIVE_STORAGE_EMAIL=
GOOGLE_DRIVE_ROOT_FOLDER_ID=

# Optional for future Shared Drive support.

GOOGLE_DRIVE_SHARED_DRIVE_ID=

# Database / app settings

DATABASE_URL=
MIDDLEWARE_RBAC=

# Allowed email domains (Required)

# Comma-separated list of domains allowed to log in

ALLOWED_EMAIL_DOMAINS="dlsu.edu.ph,carsu.edu.ph"

# Admin email patterns - users with these email patterns will be assigned admin role

# Add admin emails here, for example: admin1@example.com,admin2@carsu.edu.ph

ADMIN_EMAILS="eomorales@carsu.edu.ph"

# TTLO staff email patterns - users with these email patterns will be assigned ttlo_staff role

# Add staff emails here, for example: staff1@example.com,staff2@carsu.edu.ph

TTLO_STAFF_EMAILS=""
